{
  "name": "carfinance-web",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "ui",
    "api",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev -w ui",
    "build": "npm run build -w ui",
    "preview": "npm run preview -w ui",
    "build:api": "npm run build -w api",
    "infra:synth": "npm run synth -w infra",
    "infra:deploy": "npm run deploy -w infra",
    "infra:diff": "npm run diff -w infra",
    "infra:destroy": "npm run destroy -w infra"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
